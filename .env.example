# Token du bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Mot de passe du dashboard web
DASHBOARD_PASSWORD=

# Clé de signature des sessions (openssl rand -hex 32)
SECRET_KEY=

# Dossier de stockage (SQLite)
DATA_DIR=data

# Mettre true en production HTTPS (Render)
COOKIE_SECURE=false
